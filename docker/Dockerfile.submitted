FROM agenthon-t2-base:python-f040863673ae-amd64
LABEL qfbench2.interface_version="2.0" qfbench2.track="forecasting" qfbench2.verb="forecast"
COPY numeric-runtime /opt/numeric-runtime
COPY runtime /opt/final-focus
ENV PATH="/opt/final-focus:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin" PYTHONDONTWRITEBYTECODE=1 HOME=/tmp OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
WORKDIR /tmp
USER 65534:65534
CMD ["forecast", "--help"]
